{
    "name": "itxrahulsingh/laravel-monitor",
    "description": "Real-time monitoring for Laravel applications",
    "keywords": ["itxrahulsingh", "laravel", "monitor", "monitoring", "real-time"],
    "homepage": "https://github.com/itxrahulsingh/laravel-monitor",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/itxrahulsingh/laravel-monitor/issues",
        "source": "https://github.com/itxrahulsingh/laravel-monitor"
    },
    "authors": [
        {
            "name": "Rahul Singh",
            "email": "rahulsingh4041@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Itxrahulsingh\\LaravelMonitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Itxrahulsingh\\LaravelMonitor\\LaravelMonitorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    }
}
